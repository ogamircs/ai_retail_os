{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the cockpit WebView — notification + biometric + updater + the shell_info host command.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "notification:default",
    "biometric:default",
    "updater:default",
    {
      "identifier": "core:webview:allow-create-webview-window",
      "allow": [{ "label": "main", "url": "*" }]
    }
  ]
}
