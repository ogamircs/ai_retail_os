# Pick one: anthropic | openai | google
LLM_PROVIDER=anthropic

# Only the key for the chosen provider is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional model overrides
ANTHROPIC_MODEL=claude-opus-4-7
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-2.5-flash

# Optional open-source retail integration targets. Leave blank for mock mode.
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=

MAUTIC_BASE_URL=
MAUTIC_USERNAME=
MAUTIC_PASSWORD=
MAUTIC_BASIC_TOKEN=

MEDUSA_BASE_URL=
MEDUSA_API_KEY=

OPENBOXES_BASE_URL=
OPENBOXES_USERNAME=
OPENBOXES_PASSWORD=

AKENEO_BASE_URL=
AKENEO_CLIENT_ID=
AKENEO_SECRET=
AKENEO_USERNAME=
AKENEO_PASSWORD=

SUPERSET_BASE_URL=
